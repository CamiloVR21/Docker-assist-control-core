<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cl.bennu.assistcontrol.mapper.CountryMapper">

    <resultMap id="countryMap" type="cl.bennu.assistcontrol.domain.Country">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="nationality" column="nationality"/>

    </resultMap>

    <sql id="sqlCountry">
        <!-- @formatter:off -->
        SELECT c.id
        , c.name
        , c.nationality
        FROM country c
        <!-- @formatter:on -->
    </sql>
    <select id="getAll" resultMap="countryMap">
        <include refid="sqlCountry"/>
    </select>
    <select id="get" resultMap="countryMap" parameterType="java.lang.Long">
        <include refid="sqlCountry"/>
        <!-- @formatter:off -->
        WHERE c.id = #{id}
        <!-- @formatter:on -->
    </select>
    <select id="findByQuery" resultMap="countryMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CountryQuery">
        <include refid="sqlCountry"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="name != null">
            <bind name="_name" value="'%' + name + '%'"/>
            AND c.name LIKE #{_name}
        </if>
        <if test="nationality != null">
            <bind name="_nationality" value="'%' + nationality + '%'"/>
            AND c.nationality LIKE #{_nationality}
        </if>
    </select>
    <select id="getByQuery" resultMap="countryMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CountryQuery">
        <include refid="sqlCountry"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="name != null">
            AND c.name = #{name}
        </if>
        <if test="_nationality != null">
            AND c._nationality = #{_nationality}
        </if>
    </select>
</mapper>