<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cl.bennu.assistcontrol.mapper.CityMapper">

    <resultMap id="cityMap" type="cl.bennu.assistcontrol.domain.City">
        <result property="id" column="id"/>
        <result property="countryId" column="country_id"/>
        <result property="name" column="name"/>

    </resultMap>

    <sql id="sqlCity">
        <!-- @formatter:off -->
        SELECT c.id
        , c.country_id
        , c.name
        FROM city c
        <!-- @formatter:on -->
    </sql>
    <select id="getAll" resultMap="cityMap">
        <include refid="sqlCity"/>
    </select>
    <select id="get" resultMap="cityMap" parameterType="java.lang.Long">
        <include refid="sqlCity"/>
        <!-- @formatter:off -->
        WHERE c.id = #{id}
        <!-- @formatter:on -->
    </select>
    <select id="findByQuery" resultMap="cityMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CityQuery">
        <include refid="sqlCity"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="countryId != null">
            AND c.country_id = #{countryId}
        </if>
        <if test="name != null">
            <bind name="_name" value="'%' + name + '%'"/>
            AND c.name LIKE #{_name}
        </if>
    </select>
    <select id="getByQuery" resultMap="cityMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CityQuery">
        <include refid="sqlCity"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="countryId != null">
            AND c.country_id = #{countryId}
        </if>
        <if test="name != null">
            AND c.name = #{name}
        </if>
    </select>
</mapper>