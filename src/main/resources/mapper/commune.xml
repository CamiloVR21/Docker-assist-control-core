<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cl.bennu.assistcontrol.mapper.CommuneMapper">

    <resultMap id="communeMap" type="cl.bennu.assistcontrol.domain.Commune">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="siiCode" column="sii_code"/>
        <result property="tgrCode" column="tgr_code"/>
        <association property="city" javaType="cl.bennu.assistcontrol.domain.City">
            <id property="id" column="city_id"/>
            <result property="name" column="city_name"/>
        </association>
    </resultMap>

    <sql id="sqlCommune">
        <!-- @formatter:off -->
        SELECT c.id, c.name, c.sii_code, c.tgr_code,
        ci.id as city_id, ci.name as city_name
        FROM commune c
        LEFT JOIN city ci ON c.city_id = ci.id
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="communeMap">
        <include refid="sqlCommune"/>
    </select>

    <select id="get" resultMap="communeMap" parameterType="java.lang.Long">
        <include refid="sqlCommune"/>
        <!-- @formatter:off -->
        WHERE c.id = #{id}
        <!-- @formatter:on -->
    </select>

    <select id="findByQuery" resultMap="communeMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CommuneQuery">
        <include refid="sqlCommune"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="city != null and city.id != null">
            AND c.city_id = #{city.id}
        </if>
        <if test="name != null">
            <bind name="_name" value="'%' + name + '%'"/>
            AND c.name LIKE #{_name}
        </if>
        <if test="siiCode != null">
            <bind name="_siiCode" value="'%' + siiCode + '%'"/>
            AND c.sii_code LIKE #{_siiCode}
        </if>
        <if test="tgrCode != null">
            <bind name="_tgrCode" value="'%' + tgrCode + '%'"/>
            AND c.tgr_code LIKE #{_tgrCode}
        </if>
        <!-- @formatter:on -->
    </select>

    <select id="getByQuery" resultMap="communeMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CommuneQuery">
        <include refid="sqlCommune"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="id != null">
            AND c.id = #{id}
        </if>
        <if test="name != null">
            AND c.name = #{name}
        </if>
        <if test="siiCode != null">
            AND c.sii_code = #{siiCode}
        </if>
        <if test="tgrCode != null">
            AND c.tgr_code = #{tgrCode}
        </if>
        <!-- @formatter:on -->
    </select>

</mapper>
