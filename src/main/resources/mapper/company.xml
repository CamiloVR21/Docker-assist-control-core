<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cl.bennu.assistcontrol.mapper.CompanyMapper">

    <resultMap id="companyMap" type="cl.bennu.assistcontrol.domain.Company">
        <result property="id" column="id"/>
        <result property="communeId" column="commune_id"/>
        <result property="code" column="code"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="alias" column="alias"/>
        <result property="giro" column="giro"/>
        <result property="email" column="email"/>
        <result property="geolocation" column="geolocation"/>
        <result property="selfie" column="selfie"/>
        <result property="lag" column="lag"/>
    </resultMap>

    <sql id="sqlCompany">
        <!-- @formatter:off -->
        SELECT c.id
        , c.commune_id
        , c.code
        , c.address
        , c.phone
        , c.alias
        , c.giro
        , c.email
        , c.geolocation
        , c.selfie
        , c.lag
        FROM company c
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="companyMap">
        <include refid="sqlCompany"/>
    </select>

    <select id="get" resultMap="companyMap" parameterType="java.lang.Long">
        <include refid="sqlCompany"/>
        <!-- @formatter:off -->
        WHERE c.id = #{id}
        <!-- @formatter:on -->
    </select>

    <select id="findByQuery" resultMap="companyMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CompanyQuery">
        <include refid="sqlCompany"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="communeId != null">
            AND c.commune_id = #{communeId}
        </if>
        <if test="code != null">
            <bind name="_code" value="'%' + code + '%'"/>
            AND c.code LIKE #{_code}
        </if>
        <if test="address != null">
            <bind name="_address" value="'%' + address + '%'"/>
            AND c.address LIKE #{_address}
        </if>
        <if test="phone != null">
            <bind name="_phone" value="'%' + phone + '%'"/>
            AND c.phone LIKE #{_phone}
        </if>
        <if test="alias != null">
            <bind name="_alias" value="'%' + alias + '%'"/>
            AND c.alias LIKE #{_alias}
        </if>
        <if test="giro != null">
            <bind name="_giro" value="'%' + giro + '%'"/>
            AND c.giro LIKE #{_giro}
        </if>
        <if test="email != null">
            <bind name="_email" value="'%' + email + '%'"/>
            AND c.email LIKE #{_email}
        </if>
        <if test="geolocation != null">
            AND c.geolocation = #{geolocation}
        </if>
        <if test="selfie != null">
            AND c.selfie = #{selfie}
        </if>
        <if test="lag != null">
            AND c.lag = #{lag}
        </if>
        <!-- @formatter:on -->
    </select>

    <select id="getByQuery" resultMap="companyMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CompanyQuery">
        <include refid="sqlCompany"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="id != null">
            AND c.id = #{id}
        </if>
        <if test="code != null">
            AND c.code = #{code}
        </if>
        <if test="address != null">
            AND c.address = #{address}
        </if>
        <if test="phone != null">
            AND c.phone = #{phone}
        </if>
        <if test="alias != null">
            AND c.alias = #{alias}
        </if>
        <if test="giro != null">
            AND c.giro = #{giro}
        </if>
        <if test="email != null">
            AND c.email = #{email}
        </if>
        <if test="geolocation != null">
            AND c.geolocation = #{geolocation}
        </if>
        <if test="selfie != null">
            AND c.selfie = #{selfie}
        </if>
        <if test="lag != null">
            AND c.lag = #{lag}
        </if>
        <!-- @formatter:on -->
    </select>

    <insert id="insert" parameterType="cl.bennu.assistcontrol.domain.Company">
        INSERT INTO company (commune_id, code, address, phone, alias, giro, email, geolocation, selfie, lag)
        VALUES (#{communeId}, #{code}, #{address}, #{phone}, #{alias}, #{giro}, #{email}, #{geolocation}, #{selfie}, #{lag})
    </insert>

    <update id="update" parameterType="cl.bennu.assistcontrol.domain.Company">
        UPDATE company
        SET commune_id = #{communeId},
        code = #{code},
        address = #{address},
        phone = #{phone},
        alias = #{alias},
        giro = #{giro},
        email = #{email},
        geolocation = #{geolocation},
        selfie = #{selfie},
        lag = #{lag}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM company WHERE id = #{id}
    </delete>

</mapper>
