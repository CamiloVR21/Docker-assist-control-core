<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cl.bennu.assistcontrol.mapper.CompanyMapper">

    <resultMap id="companyMap" type="cl.bennu.assistcontrol.domain.Company">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="alias" column="alias"/>
        <result property="giro" column="giro"/>
        <result property="email" column="email"/>
        <result property="geolocation" column="geolocation"/>
        <result property="selfie" column="selfie"/>
        <result property="lag" column="lag"/>
        <association property="commune" javaType="cl.bennu.assistcontrol.domain.Commune">
            <id property="id" column="commune_id"/>
            <result property="name" column="commune_name"/>
            <result property="siiCode" column="commune_sii_code"/>
            <result property="tgrCode" column="commune_tgr_code"/>
        </association>
    </resultMap>

    <sql id="sqlCompany">
        <!-- @formatter:off -->
        SELECT c.id, c.code, c.name, c.address, c.phone, c.alias, c.giro, c.email,
        c.geolocation, c.selfie, c.lag,
        co.id as commune_id, co.name as commune_name, co.sii_code as commune_sii_code, co.tgr_code as commune_tgr_code
        FROM company c
        LEFT JOIN commune co ON c.commune_id = co.id
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="companyMap">
        <include refid="sqlCompany"/>
    </select>

    <select id="get" resultMap="companyMap" parameterType="java.lang.Long">
        <include refid="sqlCompany"/>
        <!-- @formatter:off -->
        WHERE c.id = #{id}
        <!-- @formatter:on -->
    </select>

    <select id="findByQuery" resultMap="companyMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CompanyQuery">
        <include refid="sqlCompany"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="communeQuery != null and communeQuery.id != null">
            AND co.id = #{communeQuery.id}
        </if>
        <if test="name != null">
            <bind name="_name" value="'%' + name + '%'"/>
            AND c.name LIKE #{_name}
        </if>
        <if test="code != null">
            AND c.code = #{code}
        </if>
        <if test="address != null">
            <bind name="_address" value="'%' + address + '%'"/>
            AND c.address LIKE #{_address}
        </if>
        <if test="phone != null">
            AND c.phone = #{phone}
        </if>
        <if test="alias != null">
            <bind name="_alias" value="'%' + alias + '%'"/>
            AND c.alias LIKE #{_alias}
        </if>
        <if test="giro != null">
            AND c.giro = #{giro}
        </if>
        <if test="email != null">
            <bind name="_email" value="'%' + email + '%'"/>
            AND c.email LIKE #{_email}
        </if>
        <if test="geolocation != null">
            AND c.geolocation = #{geolocation}
        </if>
        <if test="selfie != null">
            AND c.selfie = #{selfie}
        </if>
        <if test="lag != null">
            AND c.lag = #{lag}
        </if>
        <!-- @formatter:on -->
    </select>

    <select id="getByQuery" resultMap="companyMap"
            parameterType="cl.bennu.assistcontrol.domain.query.CompanyQuery">
        <include refid="sqlCompany"/>
        <!-- @formatter:off -->
        WHERE 1 = 1
        <if test="id != null">
            AND c.id = #{id}
        </if>
        <if test="name != null">
            AND c.name = #{name}
        </if>
        <if test="code != null">
            AND c.code = #{code}
        </if>
        <if test="email != null">
            AND c.email = #{email}
        </if>
        <!-- @formatter:on -->
    </select>

    <insert id="insert" parameterType="cl.bennu.assistcontrol.domain.Company" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO company (commune_id, code, name, address, phone, alias, giro, email, geolocation, selfie, lag)
        VALUES (#{commune.id}, #{code}, #{name}, #{address}, #{phone}, #{alias}, #{giro}, #{email}, #{geolocation}, #{selfie}, #{lag})
    </insert>

    <update id="update" parameterType="cl.bennu.assistcontrol.domain.Company">
        UPDATE company
        SET commune_id = #{commune.id},
        code = #{code},
        name = #{name},
        address = #{address},
        phone = #{phone},
        alias = #{alias},
        giro = #{giro},
        email = #{email},
        geolocation = #{geolocation},
        selfie = #{selfie},
        lag = #{lag}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM company WHERE id = #{id}
    </delete>

    <resultMap id="jobTypeEnumMap" type="cl.bennu.assistcontrol.enums.JobTypeEnum">
        <result column="id" javaType="cl.bennu.assistcontrol.enums.JobTypeEnum"
                typeHandler="cl.bennu.assistcontrol.enums.TypeHandler.JobTypeEnumTypeHandler"/>
    </resultMap>

    <select id="findJobTypesByCompany" parameterType="java.lang.Long" resultMap="jobTypeEnumMap">
        SELECT DISTINCT jt.id
        FROM company c
        INNER JOIN branch b ON b.company_id = c.id
        INNER JOIN employee e ON e.branch_id = b.id
        INNER JOIN job_scheduler js ON js.id = e.job_scheduler_id
        INNER JOIN job_type jt ON jt.id = js.job_type_id
        WHERE c.id = #{companyId}
    </select>
</mapper>
