<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cl.bennu.assistcontrol.mapper.AppUserMapper">

    <resultMap id="appUserMap" type="cl.bennu.assistcontrol.domain.AppUser">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="email" column="email" />
        <result property="code" column="code" />
        <result property="password" column="password" />
        <result property="img" column="img" />
        <result property="typeUser" column="type_user_id" />

        <association property="employee" javaType="cl.bennu.assistcontrol.domain.Employee">
            <id property="id" column="employee_id" />
            <result property="code" column="employee_code" />
            <result property="name" column="employee_name" />
            <result property="email" column="employee_email" />
        </association>
    </resultMap>

    <sql id="sqlAppUser">
        SELECT
        a.id,
        a.name,
        a.email,
        a.code,
        a.password,
        a.img,
        a.type_user_id,
        e.id        AS employee_id,
        e.code      AS employee_code,
        e.name      AS employee_name,
        e.email     AS employee_email
        FROM app_user a
        LEFT JOIN employee e ON a.employee_id = e.id
    </sql>

    <select id="getAll" resultMap="appUserMap">
        <include refid="sqlAppUser" />
    </select>

    <select id="get" resultMap="appUserMap" parameterType="java.lang.Long">
        <include refid="sqlAppUser" />
        WHERE a.id = #{id}
    </select>

    <select id="findByQuery" resultMap="appUserMap"
            parameterType="cl.bennu.assistcontrol.domain.query.AppUserQuery">
        <include refid="sqlAppUser" />
        WHERE 1 = 1
        <if test="name != null">
            <bind name="_name" value="'%' + name + '%'" />
            AND a.name ILIKE #{_name}
        </if>
        <if test="email != null">
            <bind name="_email" value="'%' + email + '%'" />
            AND a.email ILIKE #{_email}
        </if>
    </select>

    <insert id="insert" parameterType="cl.bennu.assistcontrol.domain.AppUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO app_user
        (name, employee_id, email, code, password, img, type_user_id)
        VALUES
        (#{name},
        #{employee.id},
        #{email},
        #{code},
        #{password},
        #{img, jdbcType=BINARY},
        #{typeUser})
    </insert>

    <update id="update" parameterType="cl.bennu.assistcontrol.domain.AppUser">
        UPDATE app_user
        SET
        employee_id   = #{employee.id},
        name          = #{name},
        email         = #{email},
        code          = #{code},
        password      = #{password},
        img           = #{img, jdbcType=BLOB},
        type_user_id  = #{typeUser.id}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM app_user
        WHERE id = #{id}
    </delete>

    <select id="findByCodeAndPassword" parameterType="map" resultMap="appUserMap">
        <include refid="sqlAppUser" />
        WHERE a.code = #{code}
        AND a.password = #{password}
    </select>

</mapper>
